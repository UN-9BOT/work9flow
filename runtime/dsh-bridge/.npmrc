# Project-local npm registry pin.
#
# Per bead work9flow-azy (dsh-A.10g, P1): the runtime/dsh-bridge
# sub-package depends on @deepseek-ai/dsh-sdk-* (0.1.1-rc.2), which
# carries shell/filesystem capabilities via the spawned dsh-jsonrpc-agent
# subprocess. Pin the registry to a single known URL so a fresh
# `npm install` is reproducible across machines and doesn't silently
# drift when the operator's ~/.npmrc changes.
#
# Operator decision: pin to the registry that matches the rest of the
# dependency snapshot already in package-lock.json
# (registry.npmmirror.com — confirmed via grep on the existing
# lockfile). Switching the lockfile to a different registry is a
# separate decision and would change resolved tarball hashes.
#
# To check:
#   cd runtime/dsh-bridge && npm config get registry
#   # → https://registry.npmmirror.com/

registry=https://registry.npmmirror.com/
